                  <Button Content="关闭" Click="DismissOverlay_Click" Style="{StaticResource Quiet}" AutomationProperties.Name="关闭账号管理" Margin="6,0,0,0"/>
                </WrapPanel>
              </StackPanel>
            </Grid>
            <Grid Visibility="{Binding LogsVisible, Converter={StaticResource VisibleIf}}">
