                <Border Background="White" CornerRadius="12" Padding="22" Margin="0,0,0,14">
                  <StackPanel>
                    <Grid>
                      <Button Content="自动检测" Style="{StaticResource Quiet}" Click="DetectJava_Click" HorizontalAlignment="Right" Padding="0"/>
                    </Grid>
                    <TextBlock Text="Java 路径" Foreground="#8B92A0" FontSize="11" Margin="0,14,0,7"/>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <TextBox Text="{Binding JavaInput, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Java 路径"/>
                      <Button Grid.Column="1" Content="浏览…" Click="BrowseJava_Click" Margin="10,0,0,0"/>
                    </Grid>
                    <ComboBox ItemsSource="{Binding JavaRuntimes}" ItemTemplate="{StaticResource JavaRuntimeItem}" Margin="0,10,0,0" SelectedValuePath="Path" SelectedValue="{Binding JavaInput, Mode=TwoWay}" AutomationProperties.Name="全局 Java 选择"/>
