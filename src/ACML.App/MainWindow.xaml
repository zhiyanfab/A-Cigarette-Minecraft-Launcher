              <Button Content="取消启动" Click="CancelLaunch_Click" Style="{StaticResource Quiet}" HorizontalAlignment="Left"/>
            </StackPanel>
            <StackPanel Visibility="{Binding JavaSwitchVisible, Converter={StaticResource VisibleIf}}" Margin="0,24,0,0">
              <TextBlock Text="Java 版本不匹配" FontSize="21" FontWeight="SemiBold"/>
              <TextBlock Text="当前版本" Foreground="#8B92A0" FontSize="11" Margin="0,22,0,6"/>
              <TextBlock Text="{Binding JavaCurrentVersion}" FontSize="16" AutomationProperties.Name="当前 Java 版本"/>
