                    <Grid Margin="0,18,0,0">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                      </Grid.ColumnDefinitions>
                      <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="内存上限 / MB" Foreground="#8B92A0" FontSize="11" Margin="0,0,0,7"/>
                        <TextBox Text="{Binding MemoryInput, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="内存上限 MB"/>
                      </StackPanel>
                      <StackPanel Grid.Column="1" Margin="0,0,12,0">
                        <TextBlock Text="游戏窗口宽度" Foreground="#8B92A0" FontSize="11" Margin="0,0,0,7"/>
                        <TextBox Text="{Binding WidthInput, UpdateSourceTrigger=PropertyChanged}"/>
                      </StackPanel>
                      <StackPanel Grid.Column="2">
                        <TextBlock Text="游戏窗口高度" Foreground="#8B92A0" FontSize="11" Margin="0,0,0,7"/>
                        <TextBox Text="{Binding HeightInput, UpdateSourceTrigger=PropertyChanged}"/>
                      </StackPanel>
                    </Grid>
                    <TextBlock Text="游戏标题（留空使用游戏默认标题）" Foreground="#8B92A0" FontSize="11" Margin="0,14,0,7"/>
