                    </WrapPanel>
                  </StackPanel>
                </Border>
                <StackPanel Orientation="Horizontal">
                  <Button Content="保存并扫描版本" Style="{StaticResource Primary}" Click="SaveSettings_Click"/>
                  <Button Content="还原未保存修改" Style="{StaticResource Quiet}" Click="ResetSettings_Click" Margin="10,0,0,0"/>
                </StackPanel>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
          <Grid Visibility="{Binding VersionManagementVisible, Converter={StaticResource VisibleIf}}" Margin="32,24">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel>
              <ComboBox ItemsSource="{Binding GameRoots}" SelectedItem="{Binding SelectedGameRoot, Mode=OneWay}" ItemTemplate="{StaticResource GameRootItem}" SelectionChanged="GameRoot_Changed" IsEnabled="{Binding CanInteract}" ToolTip="{Binding GameRootLabel}" AutomationProperties.Name="版本管理游戏根目录" Margin="0,0,0,8"/>
              <TextBlock Text="{Binding GameRootLabel}" Foreground="#9298A1" FontSize="11" Margin="0,9,0,0"/>
              <TextBlock Text="{Binding VersionCount}" Foreground="#9298A1" FontSize="11" Margin="0,5,0,16"/>
            </StackPanel>
            <ListBox Grid.Row="1" x:Name="VersionList" ItemsSource="{Binding Versions}" MinHeight="120" PreviewMouseLeftButtonUp="VersionItem_LeftClick" PreviewMouseRightButtonUp="VersionItem_RightClick" IsEnabled="{Binding CanInteract}">
