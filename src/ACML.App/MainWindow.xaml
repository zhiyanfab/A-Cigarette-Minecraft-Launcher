          <Grid>
            <StackPanel Visibility="{Binding LaunchingVisible, Converter={StaticResource VisibleIf}}" Margin="0,24,0,0">
              <TextBlock Text="正在启动游戏" FontSize="21" FontWeight="SemiBold"/>
