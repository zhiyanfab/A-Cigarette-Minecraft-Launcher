                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBox Text="{Binding PackRootInput, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="整合包游戏根目录"/>
                  <Button Grid.Column="1" Content="浏览…" Click="BrowsePackRoot_Click" Margin="8,0,0,0"/>
