                    <StackPanel Grid.Column="1">
                      <TextBlock Text="{Binding Label}" FontSize="14" FontWeight="SemiBold"/>
                      <TextBlock Text="{Binding Detail}" Foreground="#8991A1" FontSize="11" Margin="0,6,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="2" Content="⚙" Click="VersionMenu_Click" Style="{StaticResource Quiet}" ToolTip="版本管理菜单" AutomationProperties.Name="版本管理菜单"/>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Background="#F7F7F5" Visibility="{Binding NoVersions, Converter={StaticResource VisibleIf}}">
              <TextBlock Text="没有可用版本" FontSize="16" Foreground="#8B92A0" HorizontalAlignment="Center" Margin="24,16"/>
              <Button Content="前往下载" Click="GoDownload_Click" Style="{StaticResource Primary}" HorizontalAlignment="Center" Margin="0,0,0,16"/>
            </StackPanel>
            <StackPanel Grid.Row="2">
              <TextBlock Text="{Binding DialogMessage}" Foreground="#C07870" FontSize="11" Margin="0,8,0,10"/>
              <WrapPanel>
                <Button Content="刷新" Style="{StaticResource Quiet}" Click="Scan_Click"/>
                <Button Content="导入整合包" Style="{StaticResource Quiet}" Click="ImportPack_Click"/>
                <Button Content="导入游戏目录" Style="{StaticResource Quiet}" Click="ImportRoot_Click"/>
                <Button Content="前往下载" Style="{StaticResource Quiet}" Click="GoDownload_Click"/>
              </WrapPanel>
            </StackPanel>
          </Grid>
        </Grid>
      </Grid>
      <Border Grid.Row="1" Panel.ZIndex="20" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="24" Background="#F2FAF4" BorderBrush="#AED4B7" BorderThickness="1" CornerRadius="9" Padding="18,12" MaxWidth="460" Visibility="{Binding HasNotification, Converter={StaticResource VisibleIf}}">
        <TextBlock Text="{Binding Notification}" Foreground="#34734A" FontWeight="SemiBold" AutomationProperties.Name="游戏状态提示"/>
      </Border>
      <Border Grid.Row="2" Background="#FCFCFA" BorderBrush="#E3E6E6" BorderThickness="0,1,0,0" Padding="20,11" Visibility="{Binding StatusBarVisible, Converter={StaticResource VisibleIf}}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Ellipse Width="6" Height="6" Fill="#9CAAA0" Margin="0,0,10,0" Visibility="{Binding ShowStatusInput, Converter={StaticResource VisibleIf}}"/>
