                <Button Content="切换并继续" Click="AcceptJavaSwitch_Click" Style="{StaticResource Primary}"/>
                <Button Content="取消启动" Click="CancelJavaSwitch_Click" Style="{StaticResource Quiet}" Margin="8,0,0,0"/>
              </WrapPanel>
            </StackPanel>
            <StackPanel Visibility="{Binding PackVisible, Converter={StaticResource VisibleIf}}" Margin="0,24,0,0">
              <TextBlock Text="{Binding PackSummary}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,16"/>
              <StackPanel Visibility="{Binding PackIsImport, Converter={StaticResource VisibleIf}}">
                <TextBox Text="{Binding PackFilePath, Mode=OneWay}" IsReadOnly="True" TextWrapping="NoWrap"/>
