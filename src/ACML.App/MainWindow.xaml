              <TextBlock Text="游戏日志" Foreground="#8B92A0" FontSize="11" Margin="0,10,0,6"/>
              <TextBox Text="{Binding GameLogPath, Mode=OneWay}" IsReadOnly="True" TextWrapping="NoWrap" AutomationProperties.Name="游戏日志路径"/>
              <TextBlock Text="{Binding DialogMessage}" Foreground="#BD645B" FontSize="11" Margin="0,7,0,0"/>
              <WrapPanel Margin="0,15,0,0">
                <Button Content="保存错误报告" Click="SaveErrorReport_Click" Style="{StaticResource Primary}"/>
