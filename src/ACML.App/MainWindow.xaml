              <TextBlock Text="{Binding DialogMessage}" Foreground="#C07870" FontSize="11" Margin="0,8,0,0"/>
              <Button Content="保存名称" Click="ConfirmRootRename_Click" Style="{StaticResource Primary}" HorizontalAlignment="Left" Margin="0,16,0,0"/>
            </StackPanel>
            <Grid Visibility="{Binding AccountsVisible, Converter={StaticResource VisibleIf}}" Margin="0,24,0,0" KeyDown="Accounts_KeyDown">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <StackPanel>
                </StackPanel>
              <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
