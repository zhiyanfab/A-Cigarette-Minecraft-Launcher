                  </StackPanel>
                </Border>
                <Border Background="White" CornerRadius="12" Padding="22" Margin="0,0,0,14">
                  <StackPanel>
                    <TextBlock Text="下载源" Foreground="#8B92A0" FontSize="11" Margin="0,14,0,7"/>
