                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <StackPanel Grid.Row="3">
                <TextBlock Text="{Binding AccountStatus}" Foreground="#737D9A" FontSize="11"/>
                <TextBlock Text="{Binding DialogMessage}" Foreground="#C07870" FontSize="11" Margin="0,7,0,10"/>
